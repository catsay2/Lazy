    GridLayout.CellSize = UDim2.new(0.315, 0, 0, 100)
    GridLayout.CellPadding = UDim2.new(0, 12, 0, 12)
    GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
    GridLayout.Parent = Grid

    local function statCard(icon, label)
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(0, 0, 0, 100)
        Card.BackgroundColor3 = THEME.Card
        Card.Parent = Grid
        corner(14).Parent = Card

        local Ico = Instance.new("TextLabel")
        Ico.Size = UDim2.new(1, 0, 0, 28)
        Ico.Position = UDim2.new(0, 0, 0, 10)
        Ico.BackgroundTransparency = 1
        Ico.Text = icon
        Ico.TextColor3 = THEME.Accent
        Ico.TextSize = 20
        Ico.Parent = Card

        local Val = Instance.new("TextLabel")
        Val.Size = UDim2.new(1, 0, 0, 36)
        Val.Position = UDim2.new(0, 0, 0, 38)
        Val.BackgroundTransparency = 1
        Val.Text = "--"
        Val.TextColor3 = THEME.White
        Val.TextSize = 26
        Val.Font = Enum.Font.GothamBold
        Val.Parent = Card

        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, 0, 0, 20)
        Lbl.Position = UDim2.new(0, 0, 1, -20)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = label
        Lbl.TextColor3 = THEME.SubText
        Lbl.TextSize = 13
        Lbl.Font = Enum.Font.GothamSemibold
