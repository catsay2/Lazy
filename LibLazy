local TweenService = game:GetService("TweenService")
local RunService   = game:GetService("RunService")
local UIS          = game:GetService("UserInputService")
local Players      = game:GetService("Players")

local LibLazy = {}

-- ===== THEME PALETTE =====
local THEMES = {
    Black = {Bg=Color3.fromRGB(12,12,18),Card=Color3.fromRGB(26,26,38),CardHover=Color3.fromRGB(34,34,50),Accent=Color3.fromRGB(41,128,255),Text=Color3.fromRGB(255,255,255),SubText=Color3.fromRGB(160,160,180),ToggleOff=Color3.fromRGB(45,45,65),White=Color3.fromRGB(255,255,255)},
    DarkBlue = {Bg=Color3.fromRGB(10,15,30),Card=Color3.fromRGB(20,35,60),CardHover=Color3.fromRGB(30,50,80),Accent=Color3.fromRGB(60,180,255),Text=Color3.fromRGB(220,240,255),SubText=Color3.fromRGB(120,160,200),ToggleOff=Color3.fromRGB(30,50,90),White=Color3.fromRGB(255,255,255)},
    Purple = {Bg=Color3.fromRGB(20,10,30),Card=Color3.fromRGB(40,20,60),CardHover=Color3.fromRGB(55,30,80),Accent=Color3.fromRGB(180,100,255),Text=Color3.fromRGB(240,220,255),SubText=Color3.fromRGB(150,120,180),ToggleOff=Color3.fromRGB(60,30,90),White=Color3.fromRGB(255,255,255)},
    Christmas = {Bg=Color3.fromRGB(12,12,18),Card=Color3.fromRGB(26,26,38),CardHover=Color3.fromRGB(34,34,50),Accent=Color3.fromRGB(220,50,50),Text=Color3.fromRGB(255,255,255),SubText=Color3.fromRGB(160,160,180),ToggleOff=Color3.fromRGB(45,45,65),White=Color3.fromRGB(255,255,255)},
}

local THEME = THEMES.Black
local ACTIVE_THEME = "Black"
local SNOW_PARTICLES = {}
local SNOW_GUI = nil
local MAIN_WINDOW = nil

local function corner(r) local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,r);return c end
local function stroke(color,thick) local s=Instance.new("UIStroke");s.Color=color;s.Thickness=thick;s.Transparency=0.3;return s end
local function tween(obj,props,dur) TweenService:Create(obj,TweenInfo.new(dur or 0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),props):Play() end

-- ===== HIỆU ỨNG TUYẾT RƠI — CHỈ TRONG MENU ✅ =====
local CHRISTMAS_ICONS = {"❄️","❄","❅","❆","🎄","🎁","⛄","🎀","🔔","🍪"}

local function startChristmasEffect()
    if SNOW_GUI then SNOW_GUI:Destroy() end
    SNOW_PARTICLES = {}
    if not MAIN_WINDOW then return end

    SNOW_GUI = Instance.new("Frame")
    SNOW_GUI.Name="ChristmasSnow"
    SNOW_GUI.BackgroundTransparency=1
    SNOW_GUI.ClipsDescendants=true -- ✅ Chỉ trong menu
    SNOW_GUI.Size=UDim2.new(1,0,1,0)
    SNOW_GUI.ZIndex=100
    SNOW_GUI.Parent=MAIN_WINDOW

    local function createSnowflake()
        local icon=CHRISTMAS_ICONS[math.random(1,#CHRISTMAS_ICONS)]
        local p=Instance.new("TextLabel")
        p.Name="Snowflake"
        p.BackgroundTransparency=1
        p.Text=icon
        p.TextSize=math.random(10,20)
        p.TextColor3=Color3.fromRGB(255,255,255)
        p.Font=Enum.Font.GothamBold
        p.AnchorPoint=Vector2.new(0.5,0.5)
        p.Size=UDim2.new(0,24,0,24)
        p.Position=UDim2.new(math.random(5,95)/100,0,-0.1,0)
        p.Rotation=math.random(-45,45)
        p.Parent=SNOW_GUI
        table.insert(SNOW_PARTICLES,{Obj=p,SpeedY=math.random(25,65)/100,SpeedX=(math.random(-25,25)/100)+math.random()*0.2,RotSpeed=(math.random(-40,40)/100),SwayAmount=math.random(8,25)/100,SwaySpeed=math.random(12,25)/100,Phase=math.random()*math.pi*2,Y=-0.1})
    end
    for i=1,15 do task.spawn(createSnowflake) end
    local conn=RunService.RenderStepped:Connect(function(delta)
        if ACTIVE_THEME~="Christmas" then conn:Disconnect();if SNOW_GUI then SNOW_GUI:Destroy() end;SNOW_PARTICLES={};return end
        for i=#SNOW_PARTICLES,1,-1 do
            local d=SNOW_PARTICLES[i]
            d.Y+=d.SpeedY*delta
            local sway=math.sin(d.Phase+os.clock()*d.SwaySpeed)*d.SwayAmount
            local xPos=d.Obj.Position.X.Scale+(d.SpeedX+sway)*delta
            d.Obj.Position=UDim2.new(math.clamp(xPos,0.02,0.98),0,d.Y,0)
            d.Obj.Rotation+=d.RotSpeed*delta*50
            if d.Y>1.05 then d.Y=-0.1;d.Obj.Position=UDim2.new(math.random(5,95)/100,0,-0.1,0);d.Obj.Text=CHRISTMAS_ICONS[math.random(1,#CHRISTMAS_ICONS)];d.Obj.TextSize=math.random(10,20) end
        end
        if #SNOW_PARTICLES<20 and math.random()<0.02 then createSnowflake() end
    end)
end

local function stopChristmasEffect()
    ACTIVE_THEME="Black"
    if SNOW_GUI then SNOW_GUI:Destroy() end
    SNOW_PARTICLES={}
end

-- ===== TẠO WINDOW =====
