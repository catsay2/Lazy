-- ===== HIỆU ỨNG TUYẾT RƠI GIÁNG SINH =====
local CHRISTMAS_ICONS = {"❄️", "❄", "❅", "❆", "🎄", "🎁", "⛄", "🎀", "🔔", "🍪"}

local function startChristmasEffect(parentGui)
    if SNOW_GUI then SNOW_GUI:Destroy() end
    SNOW_PARTICLES = {}

    SNOW_GUI = Instance.new("ScreenGui")
    SNOW_GUI.Name = "ChristmasSnow"
    SNOW_GUI.ResetOnSpawn = false
    SNOW_GUI.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    SNOW_GUI.DisplayOrder = -999
    SNOW_GUI.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    local function createSnowflake()
        local icon = CHRISTMAS_ICONS[math.random(1, #CHRISTMAS_ICONS)]
        local particle = Instance.new("TextLabel")
        particle.Name = "Snowflake"
        particle.BackgroundTransparency = 1
        particle.Text = icon
        particle.TextSize = math.random(12, 26)
        particle.TextColor3 = Color3.fromRGB(255, 255, 255)
        particle.Font = Enum.Font.GothamBold
        particle.AnchorPoint = Vector2.new(0.5, 0.5)
        particle.Size = UDim2.new(0, 30, 0, 30)
        particle.Position = UDim2.new(math.random(0, 100)/100, 0, -0.1, 0)
        particle.Rotation = math.random(-45, 45)
        particle.Parent = SNOW_GUI

        local speedY = math.random(30, 90)/100
        local speedX = (math.random(-40, 40)/100) + (math.random() * 0.3)
        local rotationSpeed = (math.random(-60, 60)/100)
        local swayAmount = math.random(10, 40)/100
        local swaySpeed = math.random(15, 30)/100
        local phase = math.random() * math.pi * 2

        local data = {
            Obj = particle,
            SpeedY = speedY,
            SpeedX = speedX,
            RotSpeed = rotationSpeed,
            SwayAmount = swayAmount,
            SwaySpeed = swaySpeed,
            Phase = phase,
            Y = -0.1
        }
        table.insert(SNOW_PARTICLES, data)
    end

    for i = 1, 25 do task.spawn(createSnowflake) end

    local connection = RunService.RenderStepped:Connect(function(delta)
        if ACTIVE_THEME ~= "Christmas" then
            connection:Disconnect()
            if SNOW_GUI then SNOW_GUI:Destroy() end
            SNOW_PARTICLES = {}
            return
        end
        for i = #SNOW_PARTICLES, 1, -1 do
            local d = SNOW_PARTICLES[i]
            d.Y += d.SpeedY * delta
            local sway = math.sin(d.Phase + os.clock() * d.SwaySpeed) * d.SwayAmount
            local xPos = d.Obj.Position.X.Scale + (d.SpeedX + sway) * delta
            d.Obj.Position = UDim2.new(math.clamp(xPos, -0.05, 1.05), 0, d.Y, 0)
            d.Obj.Rotation += d.RotSpeed * delta * 50
            if d.Y > 1.1 then
                d.Y = -0.1
                d.Obj.Position = UDim2.new(math.random(0, 100)/100, 0, -0.1, 0)
                d.Obj.Text = CHRISTMAS_ICONS[math.random(1, #CHRISTMAS_ICONS)]
                d.Obj.TextSize = math.random(12, 26)
            end
        end
        if #SNOW_PARTICLES < 35 and math.random() < 0.03 then
            createSnowflake()
        end
    end)
end

local function stopChristmasEffect()
    ACTIVE_THEME = "Black"
    if SNOW_GUI then SNOW_GUI:Destroy() end
    SNOW_PARTICLES = {}
end

