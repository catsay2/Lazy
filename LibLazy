--!strict
--[[
====================================================================
    UI Library v1.1 — Dark theme menu
    Mới: ⚙ Settings panel (toggle) + ✕ thu nhỏ thành nút tròn nổi
====================================================================
]]
local Library = {}
Library.__index = Library

local TweenService = game:GetService("TweenService")
local RunService   = game:GetService("RunService")
local UIS          = game:GetService("UserInputService")

-- ===== CẤU HÌNH MÀU (sửa cho nhanh ở đây) =====
local THEME = {
    Bg        = Color3.fromRGB(18, 18, 26),
    Card      = Color3.fromRGB(32, 32, 44),
    Accent    = Color3.fromRGB(45, 115, 255),
    Text      = Color3.fromRGB(240, 240, 245),
    SubText   = Color3.fromRGB(140, 140, 155),
    ToggleOff = Color3.fromRGB(60, 60, 75),
    White     = Color3.fromRGB(255, 255, 255),
}

local function corner(r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); return c end
local function stroke(color, thick) local s = Instance.new("UIStroke"); s.Color = color; s.Thickness = thick; s.Transparency = 0.4; return s end
local function tween(obj, props, dur)
    TweenService:Create(obj, TweenInfo.new(dur or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

--====================================================================
--  WINDOW
--====================================================================
function Library:CreateWindow(title, openKey, floatIconId)
    local self = setmetatable({}, Library)
    self.Tabs = {}
    self.InSettings = false
    openKey = openKey or Enum.KeyCode.RightControl

    local Player = game:GetService("Players").LocalPlayer
    local Gui = Instance.new("ScreenGui")
    Gui.Name = "MenuUI"; Gui.ResetOnSpawn = false
    Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    Gui.Parent = Player:WaitForChild("PlayerGui")

    ---------- Main frame ----------
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.Size = UDim2.new(0, 580, 0, 400)
    Main.Position = UDim2.new(0.5, -290, 0.5, -200)
    Main.BackgroundColor3 = THEME.Bg
    Main.BorderSizePixel = 0
    Main.Parent = Gui
    corner(16).Parent = Main
    stroke(THEME.Accent, 2).Parent = Main

    ---------- Title bar ----------
    local TitleBar = Instance.new("Frame")
    TitleBar.Size = UDim2.new(1, 0, 0, 52)
    TitleBar.BackgroundTransparency = 1
    TitleBar.Parent = Main

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -130, 1, 0)
    Title.Position = UDim2.new(0, 60, 0, 0)
    Title.BackgroundTransparency = 1
    Title.Text = "★ " .. title .. " ★"
    Title.TextColor3 = THEME.Text
    Title.TextSize = 22
    Title.Font = Enum.Font.GothamBold
    Title.Parent = TitleBar

    -- Nút ⚙ Settings
    local BtnSettings = Instance.new("TextButton")
    BtnSettings.Size = UDim2.new(0, 38, 0, 38)
    BtnSettings.Position = UDim2.new(1, -96, 0, 7)
    BtnSettings.BackgroundColor3 = THEME.Card
    BtnSettings.Text = "⚙"; BtnSettings.TextColor3 = THEME.Text
    BtnSettings.TextSize = 20; BtnSettings.Font = Enum.Font.GothamBold
    BtnSettings.Parent = TitleBar
    corner(10).Parent = BtnSettings

    -- Nút ✕ (thu nhỏ)
    local BtnClose = Instance.new("TextButton")
    BtnClose.Size = UDim2.new(0, 38, 0, 38)
    BtnClose.Position = UDim2.new(1, -50, 0, 7)
    BtnClose.BackgroundColor3 = THEME.Card
    BtnClose.Text = "✕"; BtnClose.TextColor3 = THEME.Text
    BtnClose.TextSize = 18; BtnClose.Font = Enum.Font.GothamBold
    BtnClose.Parent = TitleBar
    corner(10).Parent = BtnClose

    local Line = Instance.new("Frame")
    Line.Size = UDim2.new(1, -24, 0, 2)
    Line.Position = UDim2.new(0, 12, 0, 50)
    Line.BackgroundColor3 = THEME.Accent
    Line.BorderSizePixel = 0
    Line.Parent = Main

    ---------- Sidebar ----------
    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, 155, 1, -64)
    Sidebar.Position = UDim2.new(0, 12, 0, 60)
    Sidebar.BackgroundTransparency = 1
    Sidebar.Parent = Main

    local LblCat = Instance.new("TextLabel")
    LblCat.Size = UDim2.new(1, 0, 0, 22)
    LblCat.BackgroundTransparency = 1
    LblCat.Text = "DANH MỤC"
    LblCat.TextColor3 = THEME.SubText
    LblCat.TextSize = 14; LblCat.Font = Enum.Font.GothamBold
    LblCat.Parent = Sidebar

    local TabList = Instance.new("Frame")
    TabList.Size = UDim2.new(1, 0, 1, -28)
    TabList.Position = UDim2.new(0, 0, 0, 28)
    TabList.BackgroundTransparency = 1
    TabList.Parent = Sidebar
    local TabLayout = Instance.new("UIListLayout")
    TabLayout.Padding = UDim.new(0, 8); TabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabLayout.Parent = TabList

    ---------- Content (chứa tab) ----------
    local Content = Instance.new("ScrollingFrame")
    Content.Size = UDim2.new(1, -185, 1, -72)
    Content.Position = UDim2.new(0, 173, 0, 60)
    Content.BackgroundTransparency = 1
    Content.ScrollBarThickness = 4
    Content.ScrollBarImageColor3 = THEME.Accent
    Content.BorderSizePixel = 0
    Content.CanvasSize = UDim2.new(0, 0, 0, 0)
    Content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Content.Parent = Main

    ---------- SETTINGS PANEL (ẩn mặc định, hiện khi bấm ⚙) ----------
    local SettingsPanel = Instance.new("ScrollingFrame")
    SettingsPanel.Name = "SettingsPanel"
    SettingsPanel.Size = UDim2.new(1, -185, 1, -72)
    SettingsPanel.Position = UDim2.new(0, 173, 0, 60)
    SettingsPanel.BackgroundTransparency = 1
    SettingsPanel.ScrollBarThickness = 4
    SettingsPanel.ScrollBarImageColor3 = THEME.Accent
    SettingsPanel.BorderSizePixel = 0
    SettingsPanel.CanvasSize = UDim2.new(0, 0, 0, 0)
    SettingsPanel.AutomaticCanvasSize = Enum.AutomaticSize.Y
    SettingsPanel.Visible = false
    SettingsPanel.Parent = Main

    local SetList = Instance.new("UIListLayout")
    SetList.Padding = UDim.new(0, 10); SetList.SortOrder = Enum.SortOrder.LayoutOrder
    SetList.Parent = SettingsPanel
    local SetPad = Instance.new("UIPadding")
    SetPad.PaddingTop = UDim.new(0, 2); SetPad.PaddingBottom = UDim.new(0, 2)
    SetPad.Parent = SettingsPanel

    -- Tiêu đề settings
    local SetTitle = Instance.new("TextLabel")
    SetTitle.Size = UDim2.new(1, 0, 0, 28)
    SetTitle.BackgroundTransparency = 1
    SetTitle.Text = "| THÔNG TIN"
    SetTitle.TextColor3 = THEME.Accent
    SetTitle.TextSize = 17; SetTitle.Font = Enum.Font.GothamBold
    SetTitle.TextXAlignment = Enum.TextXAlignment.Left
    SetTitle.Parent = SettingsPanel

    -- Hàm tạo dòng info (full width)
    local function infoRow(icon, label, value)
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, 0, 0, 48)
        Row.BackgroundColor3 = THEME.Card
        Row.Parent = SettingsPanel
        corner(12).Parent = Row
        local Ico = Instance.new("TextLabel")
        Ico.Size = UDim2.new(0, 40, 1, 0); Ico.Position = UDim2.new(0, 6, 0, 0)
        Ico.BackgroundTransparency = 1; Ico.Text = icon
        Ico.TextColor3 = THEME.Accent; Ico.TextSize = 20
        Ico.Parent = Row
        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(0.5, 0, 1, 0); Lbl.Position = UDim2.new(0, 48, 0, 0)
        Lbl.BackgroundTransparency = 1; Lbl.Text = label
        Lbl.TextColor3 = THEME.SubText; Lbl.TextSize = 15
        Lbl.Font = Enum.Font.GothamSemibold; Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = Row
        local Val = Instance.new("TextLabel")
        Val.Size = UDim2.new(0.5, -16, 1, 0); Val.Position = UDim2.new(0.5, 0, 0, 0)
        Val.BackgroundTransparency = 1; Val.Text = value
        Val.TextColor3 = THEME.Text; Val.TextSize = 15
        Val.Font = Enum.Font.GothamBold; Val.TextXAlignment = Enum.TextXAlignment.Right
        Val.Parent = Row
        return Val
    end

    local device = "PC"
    if UIS.TouchEnabled and not UIS.KeyboardEnabled then device = "Mobile"
    elseif UIS.GamepadEnabled and not UIS.KeyboardEnabled then device = "Console" end

    local RowPlayer = infoRow("👤", "Người chơi", Player.Name)
    local RowDevice = infoRow("📱", "Thiết bị", device)

    -- Grid thẻ thông số (3 cột)
    local Grid = Instance.new("Frame")
    Grid.Size = UDim2.new(1, 0, 0, 0)
    Grid.BackgroundTransparency = 1
    Grid.AutomaticSize = Enum.AutomaticSize.Y
    Grid.Parent = SettingsPanel
    local GridLayout = Instance.new("UIGridLayout")
    GridLayout.CellSize = UDim2.new(0.31, 0, 0, 95)
    GridLayout.CellPadding = UDim2.new(0, 8, 0, 8)
    GridLayout.SortOrder = Enum.SortOrder.LayoutOrder
    GridLayout.Parent = Grid

    local function statCard(icon, label)
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(0, 0, 0, 95)
        Card.BackgroundColor3 = THEME.Card
        Card.Parent = Grid
        corner(12).Parent = Card
        local Ico = Instance.new("TextLabel")
        Ico.Size = UDim2.new(1, 0, 0, 26); Ico.Position = UDim2.new(0, 0, 0, 8)
        Ico.BackgroundTransparency = 1; Ico.Text = icon
        Ico.TextColor3 = THEME.Accent; Ico.TextSize = 18
        Ico.Parent = Card
        local Val = Instance.new("TextLabel")
        Val.Size = UDim2.new(1, 0, 0, 32); Val.Position = UDim2.new(0, 0, 0, 32)
        Val.BackgroundTransparency = 1; Val.Text = "--"
        Val.TextColor3 = THEME.White; Val.TextSize = 24
        Val.Font = Enum.Font.GothamBold
        Val.Parent = Card
        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, 0, 0, 22); Lbl.Position = UDim2.new(0, 0, 1, -26)
        Lbl.BackgroundTransparency = 1; Lbl.Text = label
        Lbl.TextColor3 = THEME.SubText; Lbl.TextSize = 13
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Parent = Card
        return Val
    end

    local CardFPS    = statCard("⏱", "FPS")
    local CardPing   = statCard("📶", "Ping (ms)")
    local CardRAM    = statCard("💾", "RAM (MB)")
    local CardGPU    = statCard("🎨", "Đồ họa")
    local CardAcc    = statCard("📅", "Tuổi TK (ngày)")
    local CardGame   = statCard("🎮", "Game")
    CardGame.Text = string.sub(game.Name, 1, 12)
    CardAcc.Text = tostring(Player.AccountAge)

    -- Cập nhật live FPS / Ping / RAM mỗi giây
    local frames, fps = 0, 0
    local lastTick = tick()
    RunService.RenderStepped:Connect(function() frames += 1 end)
    task.spawn(function()
        while true do
            task.wait(1)
            local now = tick()
            fps = math.floor(frames / (now - lastTick) + 0.5)
            frames = 0; lastTick = now
            CardFPS.Text = tostring(fps)
            local ok, ping = pcall(function()
                return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
            end)
            if ok then CardPing.Text = tostring(math.floor(ping)) end
            local ok2, mem = pcall(function()
                return game:GetService("Stats"):GetTotalMemoryUsageMb()
            end)
            if ok2 then CardRAM.Text = tostring(math.floor(mem)) end
            local ok3, q = pcall(function()
                return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Name
            end)
            if ok3 then CardGPU.Text = string.sub(tostring(q), 15) end
        end
    end)

    ---------- Toggle ⚙ settings ----------
    local function toggleSettings()
        self.InSettings = not self.InSettings
        Content.Visible = not self.InSettings
        SettingsPanel.Visible = self.InSettings
        tween(BtnSettings, {BackgroundColor3 = self.InSettings and THEME.Accent or THEME.Card}, 0.15)
    end
    BtnSettings.MouseButton1Click:Connect(toggleSettings)

    ---------- Kéo thả cửa sổ ----------
    local dragging, dragInput, dragStart, startPos
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                      startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    ---------- NÚT TRÒN NỔI (hiện khi bấm ✕) ----------
    local Floating = Instance.new("ImageButton")
    Floating.Name = "FloatingBtn"
    Floating.Size = UDim2.new(0, 58, 0, 58)
    Floating.Position = UDim2.new(1, -80, 0.5, -29)
    Floating.BackgroundColor3 = THEME.Accent
    Floating.BackgroundTransparency = 0.15
    Floating.Image = ""
    Floating.Visible = false
    Floating.Parent = Gui
    corner(29).Parent = Floating
    stroke(THEME.White, 2).Parent = Floating

    local FloatLbl = Instance.new("TextLabel")
    FloatLbl.Size = UDim2.new(1, 0, 1, 0)
    FloatLbl.BackgroundTransparency = 1
    FloatLbl.Text = "☰"
    FloatLbl.TextColor3 = THEME.White
    FloatLbl.TextSize = 26; FloatLbl.Font = Enum.Font.GothamBold
    FloatLbl.Parent = Floating

    -- Kéo thả nút tròn
    local fDrag, fInput, fStart, fPos
    Floating.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            fDrag = true; fStart = input.Position; fPos = Floating.Position
        end
    end)
    Floating.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then fInput = input end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == fInput and fDrag then
            local delta = input.Position - fStart
            Floating.Position = UDim2.new(fPos.X.Scale, fPos.X.Offset + delta.X,
                                          fPos.Y.Scale, fPos.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then fDrag = false end
    end)

    -- Bấm nút tròn → mở menu
    Floating.MouseButton1Click:Connect(function()
        Floating.Visible = false
        Main.Visible = true
    end)

    -- Bấm ✕ → thu nhỏ thành nút tròn
    BtnClose.MouseButton1Click:Connect(function()
        Main.Visible = false
        Floating.Visible = true
    end)

    -- Phím tắt ẩn/hiện (luôn hoạt động cả khi đang thu nhỏ)
    UIS.InputBegan:Connect(function(input)
        if input.KeyCode == openKey then
            if Floating.Visible then
                Floating.Visible = false; Main.Visible = true
            else
                Main.Visible = not Main.Visible
            end
        end
    end)

    -- Đổi icon nút tròn bằng asset id
    function self:SetFloatingIcon(assetId)
        Floating.Image = assetId or ""
        FloatLbl.Visible = (not assetId or assetId == "")
    end
    if floatIconId then self:SetFloatingIcon(floatIconId) end

    self.Main = Main; self.Gui = Gui
    self.TabList = TabList; self.Content = Content
    self.SettingsPanel = SettingsPanel
    self.ToggleSettings = toggleSettings
    return self
end

--====================================================================
--  TAB
--====================================================================
function Library:CreateTab(name)
    local win = self
    local tab = {}; tab.Name = name; tab.Elements = {}

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 42)
    Btn.BackgroundColor3 = THEME.Card
    Btn.Text = "  " .. name
    Btn.TextColor3 = THEME.SubText
    Btn.TextSize = 15; Btn.Font = Enum.Font.GothamSemibold
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.Parent = win.TabList
    corner(10).Parent = Btn

    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -6, 0, 0)
    Container.BackgroundTransparency = 1
    Container.AutomaticSize = Enum.AutomaticSize.Y
    Container.Visible = false
    Container.Parent = win.Content
    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 10); Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = Container
    local Pad = Instance.new("UIPadding")
    Pad.PaddingTop = UDim.new(0, 2); Pad.PaddingBottom = UDim.new(0, 2)
    Pad.Parent = Container

    local function select()
        -- Bấm tab thì tự thoát khỏi settings
        if win.InSettings then win.ToggleSettings() end
        for _, t in ipairs(win.Tabs) do
            t.Button.BackgroundColor3 = THEME.Card
            t.Button.TextColor3 = THEME.SubText
            t.Container.Visible = false
        end
        Btn.BackgroundColor3 = THEME.Accent
        Btn.TextColor3 = THEME.White
        Container.Visible = true
    end
    Btn.MouseButton1Click:Connect(select)
    if #win.Tabs == 0 then select() end

    tab.Button = Btn; tab.Container = Container
    table.insert(win.Tabs, tab)

    ---------- TOGGLE ----------
    function tab:CreateToggle(label, callback)
        local state = false
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, 0, 0, 52)
        Row.BackgroundColor3 = THEME.Card
        Row.Parent = Container
        corner(12).Parent = Row

        local Dot = Instance.new("Frame")
        Dot.Size = UDim2.new(0, 10, 0, 10)
        Dot.Position = UDim2.new(0, 16, 0.5, -5)
        Dot.BackgroundColor3 = THEME.SubText
        Dot.Parent = Row; corner(5).Parent = Dot

        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, -100, 1, 0); Lbl.Position = UDim2.new(0, 38, 0, 0)
        Lbl.BackgroundTransparency = 1; Lbl.Text = label
        Lbl.TextColor3 = THEME.Text; Lbl.TextSize = 16
        Lbl.Font = Enum.Font.GothamSemibold; Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = Row

        local Switch = Instance.new("TextButton")
        Switch.Size = UDim2.new(0, 48, 0, 26)
        Switch.Position = UDim2.new(1, -64, 0.5, -13)
        Switch.BackgroundColor3 = THEME.ToggleOff
        Switch.Text = ""; Switch.Parent = Row
        corner(13).Parent = Switch

        local Knob = Instance.new("Frame")
        Knob.Size = UDim2.new(0, 20, 0, 20)
        Knob.Position = UDim2.new(0, 3, 0.5, -10)
        Knob.BackgroundColor3 = THEME.White
        Knob.Parent = Switch; corner(10).Parent = Knob

        local function apply()
            if state then
                tween(Switch, {BackgroundColor3 = THEME.Accent})
                tween(Knob, {Position = UDim2.new(1, -23, 0.5, -10)})
                Dot.BackgroundColor3 = THEME.Accent
            else
                tween(Switch, {BackgroundColor3 = THEME.ToggleOff})
                tween(Knob, {Position = UDim2.new(0, 3, 0.5, -10)})
                Dot.BackgroundColor3 = THEME.SubText
            end
        end
        Switch.MouseButton1Click:Connect(function()
            state = not state; apply()
            if callback then callback(state) end
        end)
        table.insert(tab.Elements, Row)
        return { Set = function(v) state = v; apply(); if callback then callback(state) end end }
    end

    ---------- SLIDER ----------
    function tab:CreateSlider(label, min, max, default, callback)
        local value = default or min
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, 0, 0, 60)
        Row.BackgroundColor3 = THEME.Card
        Row.Parent = Container; corner(12).Parent = Row

        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, -80, 0, 24); Lbl.Position = UDim2.new(0, 16, 0, 8)
        Lbl.BackgroundTransparency = 1; Lbl.Text = label
        Lbl.TextColor3 = THEME.Text; Lbl.TextSize = 15
        Lbl.Font = Enum.Font.GothamSemibold; Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = Row

        local ValLbl = Instance.new("TextLabel")
        ValLbl.Size = UDim2.new(0, 60, 0, 24); Val
