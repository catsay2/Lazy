            end
        end
    end)

    function self:SetFloatingIcon(assetId)
        Floating.Image = assetId or ""
        FloatLbl.Visible = (not assetId or assetId == "")
    end
    if floatIconId then self:SetFloatingIcon(floatIconId) end

    -- ===== CẬP NHẬT TOÀN BỘ THEME =====
    local themeElements = {
        MainBg = Main,
        MainStroke = MainStroke,
        Crown = Crown,
        TitleBarLine = TitleBarLine,
        BtnSettings = BtnSettings,
        BtnClose = BtnClose,
        Line = Line,
        Floating = Floating,
    }
    self._themeElements = themeElements

    function self:ApplyTheme(themeName)
        local th = THEMES[themeName] or THEMES.Black
        ACTIVE_THEME = themeName
        THEME = th

        -- Cập nhật các phần tử chính
        Main.BackgroundColor3 = th.Bg
        MainStroke.Color = th.Accent
        Crown.BackgroundColor3 = th.Accent
        TitleBarLine.BackgroundColor3 = th.Accent
        BtnSettings.BackgroundColor3 = th.Card
        BtnClose.BackgroundColor3 = th.Card
        Line.BackgroundColor3 = th.Card
        Floating.BackgroundColor3 = th.Accent

        -- Bật/tắt hiệu ứng Giáng Sinh
        if themeName == "Christmas" then
            startChristmasEffect(Gui)
        else
            stopChristmasEffect()
        end
    end

    self.Main = Main; self.Gui = Gui
    self.TabList = TabList; self.Content = Content
    self.SettingsPanel = SettingsPanel
    self.ToggleSettings = toggleSettings
    return self
end

--====================================================================
--  TAB
--====================================================================
function Library:CreateTab(name)
    local win = self
    local tab = {}; tab.Name = name; tab.Elements = {}

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 42)
    Btn.BackgroundColor3 = THEME.Card
    Btn.Text = "  " .. name
    Btn.TextColor3 = THEME.SubText
    Btn.TextSize = 14
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.Parent = win.TabList
    corner(9).Parent = Btn

    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -6, 0, 0)
    Container.BackgroundTransparency = 1
    Container.AutomaticSize = Enum.AutomaticSize.Y
    Container.Visible = false
    Container.Parent = win.Content
    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 10)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = Container
    local Pad = Instance.new("UIPadding")
    Pad.PaddingTop = UDim.new(0, 2)
    Pad.PaddingBottom = UDim.new(0, 2)
    Pad.Parent = Container

    local function select()
        if win.InSettings then win.ToggleSettings() end
        for _, t in ipairs(win.Tabs) do
            t.Button.BackgroundColor3 = THEME.Card
            t.Button.TextColor3 = THEME.SubText
            t.Container.Visible = false
        end
        Btn.BackgroundColor3 = THEME.Accent
        Btn.TextColor3 = THEME.White
        Container.Visible = true
    end
    Btn.MouseButton1Click:Connect(select)
    if #win.Tabs == 0 then select() end

    tab.Button = Btn; tab.Container = Container
    table.insert(win.Tabs, tab)

    ---------- DROPDOWN CHỌN THEME ----------
    function tab:CreateDropdown(label, options, default, callback)
        local selected = default or options[1]
        local open = false

        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, 0, 0, 50)
        Row.BackgroundColor3 = THEME.Card
        Row.Parent = Container
        corner(10).Parent = Row

        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, -80, 1, 0)
        Lbl.Position = UDim2.new(0, 14, 0, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = label
        Lbl.TextColor3 = THEME.Text
        Lbl.TextSize = 15
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = Row

        local SelectedBtn = Instance.new("TextButton")
        SelectedBtn.Size = UDim2.new(0, 140, 0, 36)
        SelectedBtn.Position = UDim2.new(1, -154, 0.5, -18)
        SelectedBtn.BackgroundColor3 = THEME.Accent
        SelectedBtn.Text = selected
        SelectedBtn.TextColor3 = THEME.White
        SelectedBtn.TextSize = 13
        SelectedBtn.Font = Enum.Font.GothamSemibold
        SelectedBtn.Parent = Row
        corner(8).Parent = SelectedBtn

        local DropList = Instance.new("Frame")
        DropList.Size = UDim2.new(0, 140, 0, 0)
        DropList.Position = UDim2.new(1, -154, 1, 4)
        DropList.BackgroundColor3 = THEME.Card
        DropList.Visible = false
        DropList.ClipsDescendants = true
        DropList.Parent = Row
        corner(8).Parent = DropList
        stroke(THEME.Accent, 1).Parent = DropList

        local DropLayout = Instance.new("UIListLayout")
        DropLayout.Padding = UDim.new(0, 2)
        DropLayout.SortOrder = Enum.SortOrder.LayoutOrder
        DropLayout.Parent = DropLayout

        local function buildList()
            for _, c in ipairs(DropList:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
            for _, opt in ipairs(options) do
                local OptBtn = Instance.new("TextButton")
                OptBtn.Size = UDim2.new(1, -4, 0, 32)
                OptBtn.Position = UDim2.new(0, 2, 0, 0)
                OptBtn.BackgroundColor3 = opt == selected and THEME.Accent or THEME.CardHover
                OptBtn.Text = opt
                OptBtn.TextColor3 = THEME.Text
                OptBtn.TextSize = 13
                OptBtn.Font = Enum.Font.GothamSemibold
                OptBtn.Parent = DropList
                corner(6).Parent = OptBtn
                OptBtn.MouseButton1Click:Connect(function()
                    selected = opt
                    SelectedBtn.Text = opt
                    open = false
                    DropList.Visible = false
                    callback(opt)
                    buildList()
                end)
            end
            DropList.CanvasSize = UDim2.new(0, 0, 0, #options * 36)
        end
        buildList()

        SelectedBtn.MouseButton1Click:Connect(function()
            open = not open
            DropList.Visible = open
        end)

        UIS.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and open then
                local p = UIS:GetMouseLocation()
                local abs = DropList.AbsolutePosition
                local sz = DropList.AbsoluteSize
                if p.X < abs.X or p.X > abs.X + sz.X or p.Y < abs.Y or p.Y > abs.Y + sz.Y then
                    open = false
                    DropList.Visible = false
                end
            end
        end)

        table.insert(tab.Elements, Row)
        return { Get = function() return selected end; Set = function(v) selected = v; SelectedBtn.Text = v; buildList() end }
    end

    ---------- TOGGLE ----------
    function tab:CreateToggle(label, callback)
        local state = false
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, 0, 0, 50)
        Row.BackgroundColor3 = THEME.Card
        Row.Parent = Container
        corner(10).Parent = Row

        local Dot = Instance.new("Frame")
        Dot.Size = UDim2.new(0, 9, 0, 9)
        Dot.Position = UDim2.new(0, 14, 0.5, -4)
        Dot.BackgroundColor3 = THEME.SubText
        Dot.Parent = Row; corner(5).Parent = Dot

        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, -100, 1, 0)
        Lbl.Position = UDim2.new(0, 34, 0, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = label
        Lbl.TextColor3 = THEME.Text
        Lbl.TextSize = 15
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = Row

        local Switch = Instance.new("TextButton")
        Switch.Size = UDim2.new(0, 46, 0, 24)
        Switch.Position = UDim2.new(1, -60, 0.5, -12)
        Switch.BackgroundColor3 = THEME.ToggleOff
        Switch.Text = ""
        Switch.Parent = Row
        corner(12).Parent = Switch

        local Knob = Instance.new("Frame")
        Knob.Size = UDim2.new(0, 18, 0, 18)
        Knob.Position = UDim2.new(0, 3, 0.5, -9)
        Knob.BackgroundColor3 = THEME.White
        Knob.Parent = Switch
        corner(9).Parent = Knob

        local function apply()
            if state then
                tween(Switch, {BackgroundColor3 = THEME.Accent})
                tween(Knob, {Position = UDim2.new(1, -21, 0.5, -9)})
                Dot.BackgroundColor3 = THEME.Accent
            else
                tween(Switch, {BackgroundColor3 = THEME.ToggleOff})
                tween(Knob, {Position = UDim2.new(0, 3, 0.5, -9)})
                Dot.BackgroundColor3 = THEME.SubText
            end
        end
        Switch.MouseButton1Click:Connect(function()
            state = not state; apply()
            if callback then callback(state) end
        end)
        table.insert(tab.Elements, Row)
        return { Set = function(v) state = v; apply(); if callback then callback(state) end end }
    end

    ---------- SLIDER ----------
    function tab:CreateSlider(label, min, max, default, callback)
        local value = default or min
        local Row = Instance.new("Frame")
        Row.Size = UDim2.new(1, 0, 0, 58)
        Row.BackgroundColor3 = THEME.Card
        Row.Parent = Container
        corner(10).Parent = Row

        local Lbl = Instance.new("TextLabel")
        Lbl.Size = UDim2.new(1, -70, 0, 22)
        Lbl.Position = UDim2.new(0, 14, 0, 6)
        Lbl.BackgroundTransparency = 1
        Lbl.Text = label
        Lbl.TextColor3 = THEME.Text
        Lbl.TextSize = 14
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.Parent = Row

        local ValBtn = Instance.new("TextButton")
        ValBtn.Size = UDim2.new(0, 55, 0, 26)
        ValBtn.Position = UDim2.new(1, -69, 0, 4)
        ValBtn.BackgroundColor3 = THEME.Accent
        ValBtn.Text = tostring(value)
        ValBtn.TextColor3 = THEME.White
        ValBtn.TextSize = 15
        ValBtn.Font = Enum.Font.GothamBold
        ValBtn.Parent = Row
        corner(8).Parent = ValBtn

        local Track = Instance.new("Frame")
        Track.Size = UDim2.new(1, -28, 0, 5)
        Track.Position = UDim2.new(0, 14, 0, 44)
        Track.BackgroundColor3 = THEME.ToggleOff
        Track.Parent = Row
        corner(3).Parent = Track

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        Fill.BackgroundColor3 = THEME.Accent
        Fill.Parent = Track
        corner(3).Parent = Fill

        local function setValue(v)
            value = math.clamp(math.floor(v + 0.5), min, max)
            local rel = (value - min) / (max - min)
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            ValBtn.Text = tostring(value)
            if callback then callback(value) end
        end

        local showInput = createInputPopup(Row, value, min, max, setValue)
        ValBtn.MouseButton1Click:Connect(showInput)

        local dragS = false
        local function updateFromPos(pos)
            local rel = math.clamp((pos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            setValue(min + rel * (max - min))
        end
        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragS = true; updateFromPos(input.Position) end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragS and input.UserInputType == Enum.UserInputType.MouseMovement then updateFromPos(input.Position) end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragS = false end
        end)

        table.insert(tab.Elements, Row)
        return { Set = setValue }
    end

    ---------- BUTTON ----------
    function tab:CreateButton(label, callback)
        local Btn2 = Instance.new("TextButton")
        Btn2.Size = UDim2.new(1, 0, 0, 44)
        Btn2.BackgroundColor3 = THEME.Card
        Btn2.Text = label
        Btn2.TextColor3 = THEME.Text
        Btn2.TextSize = 14
        Btn2.Font = Enum.Font.GothamSemibold
        Btn2.Parent = Container
        corner(10).Parent = Btn2
        Btn2.MouseButton1Click:Connect(function()
            tween(Btn2, {BackgroundColor3 = THEME.Accent}, 0.1)
            task.delay(0.12, function() tween(Btn2, {BackgroundColor3 = THEME.Card}, 0.15) end)
            if callback then callback() end
        end)
        table.insert(tab.Elements, Btn2)
    end

    ---------- SECTION ----------
    function tab:CreateSection(text)
        local Sec = Instance.new("TextLabel")
