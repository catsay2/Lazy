    local BtnCancel = Instance.new("TextButton")
    BtnCancel.Size = UDim2.new(0.48, 0, 1, 0)
    BtnCancel.BackgroundColor3 = THEME.ToggleOff
    BtnCancel.Text = "Hủy"
    BtnCancel.TextColor3 = THEME.Text
    BtnCancel.TextSize = 14
    BtnCancel.Font = Enum.Font.GothamSemibold
    BtnCancel.Parent = BtnContainer
    corner(8).Parent = BtnCancel

    local BtnOk = Instance.new("TextButton")
    BtnOk.Size = UDim2.new(0.48, 0, 1, 0)
    BtnOk.BackgroundColor3 = THEME.Accent
    BtnOk.Text = "Xác nhận"
    BtnOk.TextColor3 = THEME.White
    BtnOk.TextSize = 14
    BtnOk.Font = Enum.Font.GothamSemibold
    BtnOk.Parent = BtnContainer
    corner(8).Parent = BtnOk

    local function hide() Popup.Visible = false end
    local function confirm()
        local num = tonumber(Input.Text)
        if num then num = math.clamp(math.floor(num + 0.5), min, max) callback(num) end
        hide()
    end
    BtnCancel.MouseButton1Click:Connect(hide)
    BtnOk.MouseButton1Click:Connect(confirm)
    Input.FocusLost:Connect(function(e) if e then confirm() end end)
    Popup.MouseButton1Click:Connect(function(x) if x == Popup then hide() end end)
    return function() Popup.Visible = true; Input:CaptureFocus() end
end

