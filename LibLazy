        return Val
    end

    local CardFPS    = statCard("⏱", "FPS")
    local CardPing   = statCard("📶", "Ping")
    local CardRAM    = statCard("💾", "RAM")
    local CardGPU    = statCard("🎨", "Đồ họa")
    local CardAcc    = statCard("👤", "Tuổi TK")
    local CardGame   = statCard("🎮", "Game")
    CardGame.Text = string.sub(game.Name, 1, 14)
    CardAcc.Text = tostring(Player.AccountAge) .. " ngày"

    -- Cập nhật realtime
    local frames = 0
    local lastTick = tick()
    RunService.RenderStepped:Connect(function() frames = frames + 1 end)
    task.spawn(function()
        while true do
            task.wait(1)
            local now = tick()
            local fps = math.floor(frames / (now - lastTick) + 0.5)
            frames = 0; lastTick = now
            CardFPS.Text = tostring(fps)
            local ok, ping = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
            if ok then CardPing.Text = tostring(math.floor(ping)) .. " ms" end
            local ok2, mem = pcall(function() return game:GetService("Stats"):GetTotalMemoryUsageMb() end)
            if ok2 then CardRAM.Text = tostring(math.floor(mem)) .. " MB" end
            local ok3, q = pcall(function() return UserSettings():GetService("UserGameSettings").SavedQualityLevel.Name end)
            if ok3 then CardGPU.Text = string.sub(tostring(q), 15) end
        end
    end)

    -- Toggle Settings
    local function toggleSettings()
        self.InSettings = not self.InSettings
        Content.Visible = not self.InSettings
        SettingsPanel.Visible = self.InSettings
        tween(BtnSettings, {BackgroundColor3 = self.InSettings and THEME.Accent or THEME.Card}, 0.15)
    end
    BtnSettings.MouseButton1Click:Connect(toggleSettings)

    -- Kéo thả
    local dragging, dragInput, dragStart, startPos
    TitleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = Main.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    TitleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                      startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Nút tròn nổi
    local Floating = Instance.new("ImageButton")
    Floating.Name = "FloatingBtn"
    Floating.Size = UDim2.new(0, 64, 0, 64)
    Floating.Position = UDim2.new(1, -85, 0.5, -32)
    Floating.BackgroundColor3 = THEME.Accent
    Floating.BackgroundTransparency = 0.15
    Floating.Image = ""
    Floating.Visible = false
    Floating.Parent = Gui
    corner(32).Parent = Floating
    stroke(THEME.White, 2).Parent = Floating

    local FloatLbl = Instance.new("TextLabel")
    FloatLbl.Size = UDim2.new(1, 0, 1, 0)
    FloatLbl.BackgroundTransparency = 1
    FloatLbl.Text = "☰"
    FloatLbl.TextColor3 = THEME.White
    FloatLbl.TextSize = 28
    FloatLbl.Font = Enum.Font.GothamBold
    FloatLbl.Parent = Floating

    -- Kéo thả nút tròn
    local fDrag, fInput, fStart, fPos
    Floating.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            fDrag = true; fStart = input.Position; fPos = Floating.Position
        end
    end)
    Floating.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then fInput = input end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == fInput and fDrag then
            local delta = input.Position - fStart
            Floating.Position = UDim2.new(fPos.X.Scale, fPos.X.Offset + delta.X,
                                          fPos.Y.Scale, fPos.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then fDrag = false end
    end)

    -- Nút đóng → thu nhỏ
    BtnClose.MouseButton1Click:Connect(function()
        Main.Visible = false
        Floating.Visible = true
    end)

    -- Nút tròn → mở lại
    Floating.MouseButton1Click:Connect(function()
        Floating.Visible = false
        Main.Visible = true
    end)

    -- Phím tắt
    UIS.InputBegan:Connect(function(input)
        if input.KeyCode == openKey then
            if Floating.Visible then
                Floating.Visible = false; Main.Visible = true
            else
                Main.Visible = not Main.Visible
            end
        end
    end)

    function self:SetFloatingIcon(assetId)
        Floating.Image = assetId or ""
        FloatLbl.Visible = (not assetId or assetId == "")
    end
    if floatIconId then self:SetFloatingIcon(floatIconId) end

    self.Main = Main; self.Gui = Gui
    self.TabList = TabList; self.Content = Content
    self.SettingsPanel = SettingsPanel
    self.ToggleSettings = toggleSettings
    return self
end

