-- ==================================================
--  MAIN — GỌI THƯ VIỆN + TẠO MENU
-- ==================================================
local ok, err = pcall(function()
    -- Tải thư viện LibLazy
    local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/catsay2/Lazy/refs/heads/main/LibLazy"))()
    if not Library or not Library.CreateWindow then
        error("Không tải được LibLazy — kiểm tra kết nối")
    end

    -- Tạo cửa sổ menu
    local Window = Library:CreateWindow("LAZY MENU", Enum.KeyCode.RightControl)

    -- ===== TAB 1: HỆ THỐNG =====
    local TabHeThong = Window:CreateTab("Hệ thống")
    TabHeThong:CreateSection("Cài đặt giao diện")

    local selectedTheme = "Black"
    local ThemeDropdown = TabHeThong:CreateDropdown(
        "Chọn Theme",
        {"Black", "DarkBlue", "Purple", "Christmas"},
        "Black",
        function(themeName)
            selectedTheme = themeName
        end
    )

    TabHeThong:CreateButton("✅ Áp dụng Theme", function()
        Window:ApplyTheme(selectedTheme)
        warn("✅ Đã áp dụng theme:", selectedTheme)
    end)

    -- ===== TAB 2: MENU CHÍNH =====
    local Tab1 = Window:CreateTab("Menu Chính")
    Tab1:CreateSection("Tùy chọn chung")
    Tab1:CreateToggle("Tùy chọn 1", function(s)
        print("Tùy chọn 1:", s)
    end)
    Tab1:CreateSlider("Giá trị", 0, 100, 50, function(v)
        print("Giá trị:", v)
    end)

    warn("====================================")
    warn("✅ MENU SẴN SÀNG!")
    warn("⌨️  Nhấn RIGHT CONTROL để mở")
    warn("====================================")
end)

if not ok then
    warn("❌ LỖI:", err)
    local sg = Instance.new("ScreenGui")
    sg.ResetOnSpawn = false
    sg.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 400, 0, 120)
    lbl.Position = UDim2.new(0, 20, 0, 20)
    lbl.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
    lbl.BackgroundTransparency = 0.2
    lbl.Text = "LỖI: " .. tostring(err)
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 16
    lbl.TextWrapped = true
    lbl.Font = Enum.Font.GothamSemibold
    lbl.Parent = sg
    task.delay(10, function() sg:Destroy() end)
end
