-- Loader cho Executor
local function showError(msg)
    warn("[Menu Error]", tostring(msg))
    pcall(function()
        local sg = Instance.new("ScreenGui")
        sg.ResetOnSpawn = false
        sg.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 400, 0, 120)
        lbl.Position = UDim2.new(0, 20, 0, 20)
        lbl.BackgroundColor3 = Color3.fromRGB(180, 30, 30)
        lbl.BackgroundTransparency = 0.2
        lbl.Text = "LỖI: " .. tostring(msg)
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextSize = 16
        lbl.TextWrapped = true
        lbl.Font = Enum.Font.GothamSemibold
        lbl.Parent = sg
        task.delay(10, function() sg:Destroy() end)
    end)
end

local ok, err = pcall(function()
    if typeof(game.HttpGet) ~= "function" then
        error("Không có game:HttpGet — hãy dùng trong executor")
    end

    local src = game:HttpGet("https://raw.githubusercontent.com/catsay2/Lazy/refs/heads/main/LibLazy")
    if not src or src == "" or string.find(src, "404") then
        error("Không tải được LibLazy")
    end

    local fn = loadstring(src)
    if not fn then
        error("Lỗi cú pháp LibLazy")
    end

    local Library = fn()
    if not Library or not Library.CreateWindow then
        error("LibLazy thiếu return Library")
    end

    -- Tạo Menu
    local Window = Library:CreateWindow(
        "LAZY MENU",
        Enum.KeyCode.RightControl,
        "rbxassetid://123101346872827"
    )

    -- TAB 1: Menu Chính
    local Tab1 = Window:CreateTab("Menu Chính")
    Tab1:CreateSection("Tùy chọn chung")
    Tab1:CreateToggle("Tùy chọn 1", function(s) print("Tùy chọn 1:", s) end)
    Tab1:CreateSlider("Giá trị", 0, 100, 50, function(v) print("Giá trị:", v) end)
    Tab1:CreateButton("Nút test", function() print("Đã bấm!") end)

    -- TAB 2
    local Tab2 = Window:CreateTab("Tab Khác")
    Tab2:CreateToggle("Tùy chọn A", function(s) print(s) end)
end)

if not ok then
    showError(err)
end
