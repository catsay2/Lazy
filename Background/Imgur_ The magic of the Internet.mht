@-webkit-keyframes rotateRightStartPaused { 
  0% { transform: rotate(360deg); top: 0px; left: 9px; width: 3px; height: 18px; }
  100% { transform: rotate(180deg); top: -1px; left: 7px; width: 3.3px; height: 15px; }
